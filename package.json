{
  "name": "cineverse-ai",
  "version": "1.0.0",
  "description": "CineVerse AI - Complete Advanced Movie Ticket Booking Platform",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "seed": "node scripts/seedDatabase.js",
    "seed:shows": "node backend/src/scripts/seedDynamicShows.js",
    "create-admin": "node scripts/createAdmin.js",
    "create-customer": "node scripts/createCustomer.js",
    "setup-users": "node scripts/setupUsers.js",
    "start:backend": "npm run start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test:backend": "npm run test --prefix backend",
    "build:frontend": "npm install --prefix frontend && npm run build --prefix frontend",
    "test": "npm run test:backend",
    "build": "npm run build:frontend",
    "seed:tn": "node backend/src/scripts/seedTamilNaduTheatres.js",
    "test:tn": "node backend/src/scripts/comprehensiveTamilNaduTest.js",
    "test:permissions": "node backend/src/scripts/testPermissionsAndWorkflows.js"
  },
  "keywords": ["mern", "movie-booking", "cineverse", "ai", "leaflet", "socket.io"],
  "author": "CineVerse AI Team",
  "license": "ISC"
}
