# ========================================================
# CineVerse AI - Environment Configuration Example
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/cineverse_ai

# Authentication & Security
JWT_SECRET=super_secret_cineverse_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Seat Lock Configuration (in minutes)
SEAT_LOCK_TIMEOUT_MINUTES=5

# Admin Bootstrap Credentials (Used by scripts/createAdmin.js)
ADMIN_NAME=CineVerse SuperAdmin
ADMIN_EMAIL=admin@cineverse.com
ADMIN_PASSWORD=Admin@CineVerse2026
ADMIN_PHONE=9876543210

# Optional External AI Assistant API Key (Google Gemini)
# Leave blank to use built-in intelligent rule-based movie recommendation engine
GEMINI_API_KEY=

# Optional Free Movie Data API (The Movie Database - TMDB)
# Sign up free at https://www.themoviedb.org/settings/api to get an API key
# When configured, CineVerse AI can sync trending and upcoming films directly from TMDB
TMDB_API_KEY=

# Optional Geocoding API (e.g. OpenCage or LocationIQ)
# Leave blank to use built-in reverse geocoding with OpenStreetMap Nominatim
GEOCODING_API_KEY=

# Optional Email / Notification Service (e.g. Resend, Sendgrid, SMTP)
# Leave blank to use in-memory / development mode simulated notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@cineverse.com
